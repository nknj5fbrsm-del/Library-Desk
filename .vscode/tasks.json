{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev Server (Auto Start)",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      },
      "problemMatcher": {
        "owner": "custom",
        "pattern": [{ "regexp": ".+" }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".+",
          "endsPattern": "start electron app"
        }
      }
    }
  ]
}
